# Kilonova environment contract. Copy to .env for local development; the
# process reads .env itself (so it survives `sudo ./kn main`), and real
# environment variables always win over the file. `kn --help` and
# `kn grader-serve --help` list the same variables with their defaults.
#
# Runtime-editable instance settings (default language, memory cap per test,
# banned hot problems, every feature toggle) live in flags.json instead and are
# edited from the admin UI. Migrate a legacy config.toml / grader.toml with:
#   ./kn config-migrate -c config.toml --grader-config grader.toml -f flags.json > .env

## Platform (kn main)
KN_FLAGS_PATH=./flags.json
KN_DATA_DIR=/var/lib/kilonova/data        # required, absolute; logs go to $KN_DATA_DIR/logs
KN_DEBUG=false
KN_HOST_PREFIX=http://localhost:8070      # public URL, used for CORS and OIDC
# Empty KN_DB_DSN falls back to the libpq PGHOST/PGUSER/PGPASSWORD/PGDATABASE/... variables.
KN_DB_DSN="host=/var/run/postgresql dbname=kilonova user=kilonova sslmode=disable application_name=kilonova"

# Mail is enabled when KN_SMTP_HOST is set.
KN_SMTP_HOST=
KN_SMTP_USERNAME=
KN_SMTP_PASSWORD=
KN_SMTP_FROM=

# local = in-process sandbox; remote = talk to a kn grader-serve instance.
KN_EVAL_MODE=local
KN_EVAL_REMOTE_ENDPOINT=                  # https://grader:9000 (remote only)
KN_EVAL_REMOTE_TOKEN=                     # token registered on the grader as KN_GRADER_CLIENT_<NAME>

## Sandbox capacity (kn main in local mode, and kn grader-serve)
KN_SANDBOX_NUM_CONCURRENT=3
KN_SANDBOX_GLOBAL_MAX_MEM_KB=3145728
KN_SANDBOX_STARTING_BOX=1

## Remote grader (kn grader-serve). KN_DATA_DIR is its root too: scratch/ and logs/ live under it.
KN_GRADER_LISTEN=:9000
KN_GRADER_TLS_CERT=/etc/kilonova/grader.crt
KN_GRADER_TLS_KEY=/etc/kilonova/grader.key
KN_GRADER_SCRATCH_TTL_SEC=3600
# One variable per allowed platform client; the suffix, lowercased, is the client name.
KN_GRADER_CLIENT_KILONOVA=<token>


# Ad-hoc flag overrides for one run, e.g. KN_FLAG_OVERRIDES=server.listen.port=8071,behavior.db.log_sql=true
#KN_FLAG_OVERRIDES=
